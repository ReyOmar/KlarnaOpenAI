# Copia este archivo como backend/.env y completa los valores.

# ─── Base de datos PostgreSQL ───────────────────────────────
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/klarna_openai?schema=public"

# ─── Servidor ───────────────────────────────────────────────
PORT=3001
# Orígenes permitidos si el frontend se despliega en otro dominio (separados por coma).
# Déjalo vacío para aceptar cualquiera (modo pruebas).
CORS_ORIGIN=

# ─── Proveedor de IA ────────────────────────────────────────
# Opciones: openai | ollama | groq | gemini | custom | simulado
#   ollama   → local y gratis (https://ollama.com). No requiere API key.
#   groq     → nube, tiene plan gratuito (https://console.groq.com/keys).
#   gemini   → nube, tiene plan gratuito (https://aistudio.google.com/apikey).
#   custom   → cualquier API compatible con OpenAI (OpenRouter, LM Studio, Mistral...).
#   simulado → respuestas de ejemplo sin llamar a ninguna IA.
# Si se deja vacío y existe OPENAI_API_KEY, se usa OpenAI.
AI_PROVIDER=ollama

# API key del proveedor (no necesaria para ollama ni simulado)
AI_API_KEY=

# Opcionales: sobrescriben la URL y los modelos por defecto del proveedor.
#   ollama → Terra: qwen2.5:7b              Luna: llama3.2:3b
#   groq   → Terra: llama-3.3-70b-versatile Luna: llama-3.1-8b-instant
#   gemini → Terra: gemini-3.5-flash        Luna: gemini-3.5-flash-lite
#   openai → Terra: gpt-4o                  Luna: gpt-4o-mini
AI_BASE_URL=
AI_MODEL_TERRA=
AI_MODEL_LUNA=

# Máximo de tokens de salida por respuesta y timeout de la llamada (ms)
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=60000

# Si la IA falla (sin créditos, sin red...) responder con texto simulado
# en lugar de devolver error. Pon "false" para ver el error real.
AI_FALLBACK_SIMULADO=true

# Compatibilidad con la versión anterior (solo se usa si AI_PROVIDER=openai o vacío)
OPENAI_API_KEY=
